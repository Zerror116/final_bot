# Telegram bot
BOT_TOKEN=
BOT_LINK=
# Or use BOT_USERNAME instead of BOT_LINK
# BOT_USERNAME=

# Telegram chats/links
CHANNEL_ID=
TARGET_GROUP_ID=
ARCHIVE_ID=
DELIVERY_ARCHIVE_ID=
DELIVERY_CHANNEL_ID=
CHANNEL_LINK=
SUPPORT_LINK=

# Bot roles
ADMIN_USER_ID=
PROTECTED_USER_ID=

# Database
# Preferred:
DATABASE_URL=

# Or use separate DB settings instead of DATABASE_URL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=final_bot
# DB_USER=
# DB_PASSWORD=

# Optional
# LOG_LEVEL=INFO
# TELEGRAM_PROXY_URL=
# Or configure a proxy from parts instead of TELEGRAM_PROXY_URL
# TELEGRAM_PROXY_SCHEME=socks5
# TELEGRAM_PROXY_HOST=
# TELEGRAM_PROXY_PORT=
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=
# TELEGRAM_STARTUP_RETRY_SECONDS=5
# TELEGRAM_STARTUP_MAX_RETRY_SECONDS=60
# TELEGRAM_API_RETRY_ON_ERROR=true
# TELEGRAM_API_MAX_RETRIES=3
# TELEGRAM_API_RETRY_TIMEOUT_SECONDS=2
# TELEGRAM_POLLING_TIMEOUT_SECONDS=15
# TELEGRAM_LONG_POLLING_TIMEOUT_SECONDS=30
# RESERVATION_DB_RETRY_ATTEMPTS=5
# RESERVATION_DB_RETRY_BASE_SECONDS=0.5
# PATH_TO_CONFIG=config.json
# ENV_FILE=.env

# Statistic API for the Android/web statistics screen
# STATISTIC_API_TOKEN=
# STATISTIC_API_HOST=127.0.0.1
# STATISTIC_API_PORT=8091
# STATISTIC_API_REFRESH_SECONDS=3600
# STATISTIC_API_CORS_ORIGIN=http://127.0.0.1:8765,http://localhost:8765

# Physical button restart API
# FINAL_BOT_BUTTON_TOKEN=
# FINAL_BOT_BUTTON_HOST=0.0.0.0
# FINAL_BOT_BUTTON_PORT=8092
# FINAL_BOT_SERVICE_NAME=final_bot.service
# FINAL_BOT_BUTTON_RESTART_COOLDOWN_SECONDS=30

# Google Sheets delivery collection
# GOOGLE_SHEETS_SPREADSHEET_ID=1RQ4Xx8iH1R_A_Y5OrNS4R0c5dPW5R5T89oBwotLxm0s
